partial alphanumeric_keys
xkb_symbols "basic" {

    include "ch(fr_nodeadkeys)"

    key <AE11>	{[ apostrophe, question, acute ]};
    key <AE12>	{[ asciicircum, grave, asciitilde ]};

    key <AD01> { [ q, Q ] };
    key <AD02> { [ l, L ] };
    key <AD03> { [ u, U ] };
    key <AD04> { [ comma, semicolon ] };
    key <AD05> { [ period, colon ] };
    key <AD06> { [ f, F ] };
    key <AD07> { [ w, W ] };
    key <AD08> { [ r, R ] };
    key <AD09> { [ y, Y ] };
    key <AD10> { [ p, P ] };
    key <AD11> { [ asciitilde,  braceright, bracketleft ] };
    key <AD12> { [ exclam, question, bracketright ] };

    key <AC01> { [ e, E, EuroSign ] };
    key <AC02> { [ i, I ] };
    key <AC03> { [ a, A ] };
    key <AC04> { [ o, O ] };
    key <AC05> { [ minus, underscore, asciitilde ] };
    key <AC06> { [ k, K ] };
    key <AC07> { [ t, T ] };
    key <AC08> { [ n, N ] };
    key <AC09> { [ s, S ] };
    key <AC10> { [ h, H ] };
    key <AC11> { [ exclam, braceright ] };
    key <BKSL> { [ yen, dollar, braceright ] };

    key <AB01> { [ z, Z ] };
    key <AB02> { [ x, X ] };
    key <AB03> { [ c, C ] };
    key <AB04> { [ v, V ] };
    key <AB05> { [ bracketleft, bracketright, asciitilde ] };
    key <AB06> { [ g, G ] };
    key <AB07> { [ d, D ] };
    key <AB08> { [ m, M ] };
    key <AB09> { [ j, J ] };
    key <AB10> { [ b, B ] };
};
